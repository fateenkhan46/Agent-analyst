# Agent Analyst — deployment configuration.
#
# Every value here comes from the environment. Nothing is defaulted to a real
# credential and nothing reaches the browser bundle. Load the secrets from your
# platform's secret store (Azure Key Vault, AWS Secrets Manager, Kubernetes
# Secrets) rather than from a file on disk.
#
# With ENVIRONMENT=production the application AUDITS THESE AT BOOT and refuses
# to start if any of the blocking items below is wrong. A misconfigured
# deployment fails its health check instead of serving traffic while open.

# ---------------------------------------------------------------- required
ENVIRONMENT=production

# Signs session tokens. At least 32 random characters.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Every replica must share the same value, or a user signed in on one replica
# is rejected by the next.
AUTH_SECRET=

# PostgreSQL. SQLite is refused in production: it serialises writers, cannot be
# shared between replicas, and does not survive a restart without a volume.
DATABASE_URL=postgresql+psycopg://agent_analyst:CHANGE_ME@postgres:5432/agent_analyst

# The exact browser origin of the front end. No wildcards, no localhost.
CORS_ORIGINS=https://agent-analyst.internal.example.com

# ---------------------------------------------------------------- identity
# Self-registration. Leave false on a corporate deployment: accounts come from
# the directory, not from anyone who can reach the API.
ALLOW_OPEN_REGISTRATION=false

# Development auth attributes unauthenticated requests to a local user. It is
# inert unless ENVIRONMENT=development, but production refuses to start with it
# left on, so that one variable cannot switch authentication off.
ALLOW_DEV_AUTH=false

# Corporate SSO. The app speaks no SAML or OIDC itself; it trusts the identity
# a front-facing authenticating proxy has already verified:
#   - Azure App Service / Container Apps "Authentication" (EasyAuth) with Entra ID
#   - an AWS ALB with an OIDC authenticate action
#   - oauth2-proxy or an ingress-level OIDC filter
#
# ONLY set this true when the application cannot be reached except through that
# proxy. If anything can reach the container directly, a caller sets the header
# and becomes whoever they like. Enforce it with a private network, a
# VNet/VPC-internal ingress, or a service mesh policy — not by convention.
TRUST_PROXY_AUTH=false
PROXY_AUTH_EMAIL_HEADER=x-auth-request-email
PROXY_AUTH_USER_HEADER=x-auth-request-user
PROXY_AUTH_GROUPS_HEADER=x-auth-request-groups
# Directory groups whose members get the admin role. Everyone else is a member,
# so joiners and leavers are handled by the directory, not by this application.
PROXY_ADMIN_GROUPS=

AUTH_TOKEN_TTL_SECONDS=43200

# ---------------------------------------------------------------- transport
# Strict-Transport-Security. Leave 0 until TLS is terminated in front of the
# app; sending it earlier locks browsers out over plain HTTP.
HSTS_SECONDS=31536000

# ---------------------------------------------------------------- throttling
# In-process and per worker. The container runs 4 uvicorn workers, so the real
# ceiling is 4 x this per replica, and 4 x this x replicas overall. It guards
# against a runaway client, not a distributed attack — that belongs at the
# gateway or WAF in front of the app. Set it against that arithmetic, or put
# the real limit at the ingress.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------------------------------------------------------------- storage
# local writes under DATA_DIR (mount a persistent volume); s3 uses S3 or any
# S3-compatible endpoint, including Azure Blob through a gateway.
STORAGE_BACKEND=local
DATA_DIR=/var/lib/agent-analyst
# S3_BUCKET=
# S3_ENDPOINT_URL=

MAX_UPLOAD_BYTES=67108864
MAX_FILES_PER_PROJECT=40
MAX_ROWS_PROFILED=1000000

# ---------------------------------------------------------------- LLM
#
#   *** READ THIS BEFORE SETTING A KEY ***
#
# Left empty, the system makes NO external calls at all: a deterministic
# planner runs instead, and refuses what it cannot derive rather than guessing.
# That is the current default and it keeps all data inside your network.
#
# Setting a key means UPLOADED BUSINESS DATA AND MEETING TRANSCRIPTS ARE SENT
# TO A THIRD-PARTY API. Specifically: column names and sample values from the
# profiled sources, the meeting transcript text, and the generated artifacts.
# That is a data-processing and data-residency decision for your privacy and
# third-party-risk functions, not an engineering one.
#
# Production logs a warning naming this when a key is present, so it appears in
# the deployment record.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-5-5
DEFAULT_PROJECT_BUDGET_USD=5.0

# ---------------------------------------------------------------- Power BI
# Unused today: no publish-to-service integration is implemented. Present so
# the setting names are agreed before that work starts.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
